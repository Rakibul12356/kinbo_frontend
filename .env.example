# Browser calls this base URL (same-origin proxy via next.config rewrites).
NEXT_PUBLIC_API_URL=/api/v1

# Real Express backend (used only by Next.js rewrite / server).
BACKEND_URL=https://kinbo-backend.onrender.com

# Absolute host for uploaded images (/uploads/...).
NEXT_PUBLIC_STATIC_URL=https://kinbo-backend.onrender.com
